= תרגיל 5

== שאלה 1
#problem[
    מצאו בסיס לתת המרחב הוקטורי של $FF_7 ^4$, הנתון ע"י:
    $ {vec(x_1, x_2, x_3, x_4) in FF_7 ^4 whe cases(
    x_1 + 4x_2 + 2x_4 = 0,
    2x_1 + x_2 + x_3 + 3 x_4 = 0
    )} $
]

== שאלה 2
#problem[
    בכל אחד מהסעיפים נתון מרחב וקטורי $V$ מעל שדה $RR$, $v in V$ וקטור, ו - $cal(B)$ בסיס של $V$ (אין צורך להוכיח כי הוא אכן בסיס).

    חשבו את עמודת הקואורדינטות $[v]_cal(B)$:
    + $ v = vec(1,2,3), quad quad cal(B) = (vec(1,1,1), vec(1,1,0), vec(1, 0, 0)), quad quad V = RR^3 $
    + $ v = 2x^2 + 5x + 6, quad quad cal(B) = (1 + 2x, x - x^2, x + x^2), quad quad V = RR[x]_(<= 2) $
]
#solution[
    *(א)* אנחנו רוצים למצוא וקטור $vec(d_1, d_2, d_3)$ כך ש:
    $ vec(1,2,3) = d_1 vec(1,1,1) + d_2 vec(1,1,0) + d_3 vec(1,0,0) = vec(d_1, d_2, d_3) mat(1, 1, 1; 1, 1, 0; 1, 0, 0) $
    כלומר, נוכל למצוא את הוקטור ע"י פתירת הממ"ל המיוצגת ע"י המטריצה הבאה:
    $ mat(
    1, 1, 1, 1;
    1, 1, 0, 2;
    1, 0, 0, 3;
    augment: #3
    ) $
    נדרג אותה:
    $ mat(
    hl(1), 1, ,1, 1;
    1, 1, 0, 2;
    1, 0, 0, 3;
    augment:#3
    ) ero(R_2 -> R_2 - 1 R_1) mat(
    1, 1, 1, 1;
    0, 0, -1, 1;
    1, 0, 0, 3;
    augment: #3
    ) ero(R_3 -> R_3 - 1 R_1) mat(
    1, 1, 1, 1;
    0, 0, -1, 1;
    0, -1, -1, 2;
    augment: #3
    ) $
    $ mat(
    1, 1, 1, 1;
    0, 0, hl(-1), 1;
    0, -1, -1, 2;
    augment: #3
    ) ero(R_2 -> -1 R_2) mat(
    1, 1, 1, 1;
    0, 0, 1, -1;
    0, -1, -1, 2;
    augment: #3
    ) ero(R_1 -> R_1 - 1 R_2) mat(
    1, 1, 0, 2;
    1, 0, 1, -1;
    0, -1, -1, 2;
    augment: #3
    ) ero(R_3 -> R_3 + 1 R_) $
    
]
